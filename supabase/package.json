{
  "name": "theou-database-tests",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:edge": "deno check --frozen --config functions/social-api/deno.json functions/social-api/index.ts",
    "lint:edge": "deno lint --config functions/social-api/deno.json functions/social-api",
    "test": "node --test tests/*.test.ts",
    "test:cloud": "node --env-file=.env.test.local --test tests/cloud.integration.ts",
    "test:t04-cloud": "node --env-file=.env.test.local scripts/t04-cloud.ts",
    "test:t06-cloud": "node --env-file=.env.auth.local scripts/t06-cloud.ts",
    "test:t08-cloud": "node --env-file=.env.auth.local scripts/t08-cloud.ts",
    "test:t09-cloud": "node --env-file=.env.auth.local scripts/t09-cloud.ts",
    "auth:manual": "node --env-file=.env.auth.local scripts/auth-manual.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@supabase/supabase-js": "2.119.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
