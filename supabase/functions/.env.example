# Mẫu cho Edge Function, không phải env của frontend hoặc manual Auth runner.
# Cloud cung cấp SUPABASE_URL và SUPABASE_SERVICE_ROLE_KEY; không chép các key đó vào source.
# THEOU_PUBLISHABLE_KEY lấy từ API Keys của cùng project; chỉ dùng xác minh Auth.
THEOU_PUBLISHABLE_KEY=
# CORS: origin đầy đủ, ngăn cách bằng dấu phẩy; không dùng * hoặc URL có path.
THEOU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# T06: secret HMAC riêng cho cursor, 43–128 ký tự base64url ngẫu nhiên; chỉ lưu Edge secrets.
THEOU_POST_CURSOR_SECRET=
