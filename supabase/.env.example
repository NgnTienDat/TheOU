# Chỉ sao chép sang supabase/.env.test.local sau khi được phê duyệt Giai đoạn B.
# Giữ rỗng để khóa test ghi Cloud theo mặc định.
THEOU_ALLOW_CLOUD_TESTS=
# Chỉ chấp nhận TheOU-dev: puhkisyehspcmgzerutm (đối chiếu cloud-config.ts).
THEOU_TEST_PROJECT_REF=
THEOU_TEST_SUPABASE_URL=
# Gmail gốc do bạn quản lý, không có +alias; username 6–30 ký tự.
# Runner tạo username+theou-t02-{runId}-{a|b}@gmail.com; không điền email thật vào file mẫu.
THEOU_TEST_EMAIL_BASE=
THEOU_TEST_PUBLISHABLE_KEY=
# Chỉ test Node phía server sử dụng; không bao giờ dùng tiền tố VITE_ cho secret.
THEOU_TEST_SECRET_KEY=

# T03-A: sao chép mẫu sang .env.auth.local, chỉ điền nhóm biến manual bên dưới.
# Cờ xác nhận: theou-dev. Không lưu email cá nhân, mật khẩu hoặc OTP vào file env.
THEOU_ALLOW_AUTH_TESTS=
THEOU_AUTH_SUPABASE_URL=
THEOU_AUTH_PUBLISHABLE_KEY=

# Sau khi bật hook OU, không dùng suite T02 Admin API/Gmail để nghiệm thu domain OU.
# Đặt true khi đã xác nhận trên Dashboard; runner T02 dừng trước mọi request.
THEOU_OU_HOOK_ENABLED=
