# Chỉ sao chép sang supabase/.env.test.local sau khi được phê duyệt Giai đoạn B.
# Giữ rỗng để khóa test ghi Cloud theo mặc định.
THEOU_ALLOW_CLOUD_TESTS=
# Chỉ chấp nhận TheOU-dev: puhkisyehspcmgzerutm (đối chiếu cloud-config.ts).
THEOU_TEST_PROJECT_REF=
THEOU_TEST_SUPABASE_URL=
# Gmail gốc do bạn quản lý, không có +alias; username 6–30 ký tự.
# Runner tạo username+theou-t02-{runId}-{a|b}@gmail.com; không điền email thật vào file mẫu.
THEOU_TEST_EMAIL_BASE=
THEOU_TEST_PUBLISHABLE_KEY=
# Chỉ test Node phía server sử dụng; không bao giờ dùng tiền tố VITE_ cho secret.
THEOU_TEST_SECRET_KEY=

# T03-A: sao chép mẫu sang .env.auth.local, chỉ điền nhóm biến manual bên dưới.
# Cờ xác nhận: theou-dev. Không lưu email cá nhân, mật khẩu hoặc OTP vào file env.
THEOU_ALLOW_AUTH_TESTS=
THEOU_AUTH_SUPABASE_URL=
THEOU_AUTH_PUBLISHABLE_KEY=

# Sau khi bật hook OU, không dùng suite T02 Admin API/Gmail để nghiệm thu domain OU.
# Đặt true khi đã xác nhận trên Dashboard; runner T02 dừng trước mọi request.
THEOU_OU_HOOK_ENABLED=

# T04-B.7: runner riêng, dùng lại THEOU_TEST_PROJECT_REF/URL/PUBLISHABLE_KEY/SECRET_KEY.
# Không cần Gmail base, không tắt hook OU; chỉ đặt theou-dev sau review runner.
THEOU_ALLOW_T04_CLOUD_TESTS=

# T06-B.5: dùng URL/publishable key/cờ Auth T03 trong .env.auth.local.
# Mặc định nhập A/B ẩn ở terminal. T06 cho phép env runtime/file local gitignore nếu cần tự chạy smoke.
# Không điền credentials thật vào file mẫu, không gửi qua chat hoặc command line.
THEOU_T06_EMAIL_A=
THEOU_T06_PASSWORD_A=
THEOU_T06_EMAIL_B=
THEOU_T06_PASSWORD_B=
# Chỉ đặt theou-dev sau khi smoke PASS và chủ dự án duyệt --write riêng; smoke không cần cờ này.
THEOU_ALLOW_T06_CLOUD_WRITES=

# T08-B.5: dùng lại nhóm Auth T03 và credentials A/B T06 trong .env.auth.local đã gitignore.
# Smoke không cần cờ write. Chỉ đặt theou-dev sau phê duyệt --write riêng.
THEOU_ALLOW_T08_CLOUD_WRITES=
# R2: cờ riêng, chỉ đặt theou-dev sau review/phê duyệt --resume-delete; không dùng cờ write thay thế.
THEOU_ALLOW_T08_RESUME_DELETES=
# Tự tìm native CLI 3.1.0 trên PATH hoặc npm/npx cache Windows, không tự cài package.
# Tùy chọn: đường dẫn native supabase.exe; không nhập npx.cmd/supabase.cmd hoặc cả command.
THEOU_SUPABASE_CLI=

# T09-B.6: cùng credentials A/B và nhóm Auth T03; cờ T08 không mở quyền ghi T09.
# Chỉ điền hai giá trị dưới vào .env.auth.local sau review riêng; mặc định khóa write.
THEOU_ALLOW_T09_CLOUD_WRITES=
THEOU_T09_POST_ID=

# T10-C.1: LOCAL preparation; chỉ đặt từng cờ sau phê duyệt Cloud tương ứng.
# Dùng lại Auth/A-B T06; --smoke mặc định, không cần secret hoặc write flags.
THEOU_ALLOW_T10_DRAFT_WRITES=
THEOU_ALLOW_T10_PUBLISH_WRITES=
# Publish BLOCKED khi chưa duyệt giữ fixture: chưa có deletePost/cleanup PUBLISHED an toàn.
# Chỉ đặt approved sau quyết định retention riêng của chủ dự án.
THEOU_T10_RETAIN_PUBLISHED_FIXTURE=
# Draft/publish cần THEOU_TEST_SECRET_KEY trong .env.auth.local để Node chỉ GET info/download
# exact objects trong inventory; không gửi secret vào social-api, frontend hoặc log.
