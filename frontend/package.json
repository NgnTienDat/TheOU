{
  "name": "theou-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.ts",
    "test:ui": "node scripts/ui-check.mjs",
    "test:ui:feed": "node scripts/feed-ui-check.mjs",
    "test:ui:comments": "node scripts/comments-ui-check.mjs",
    "test:ui:votes": "node scripts/votes-ui-check.mjs",
    "test:ui:media": "node scripts/media-ui-check.mjs",
    "test:ui:moderation": "node scripts/moderation-ui-check.mjs",
    "test:ui:e2e": "node scripts/e2e-ui-check.mjs",
    "test:ui:landing": "node scripts/landing-ui-check.mjs",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
